From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kevin Turcios <turcioskevinr@gmail.com>
Date: Thu, 22 Oct 2026 06:29:48 -0500
Subject: [PATCH] Python3.14: Fix, the "__annotate__" code cache was published
 without memory ordering

Without the GIL, a thread could see the cached code object's pointer before
the code object, on a weakly ordered CPU, and two threads both filling the
cache leaked one. The cache is now read with acquire ordering and filled by
compare-and-swap; the thread that loses releases its copy. With the GIL the
generated code is unchanged. Reported as Nuitka#4119.

Signed-off-by: Kevin Turcios <turcioskevinr@gmail.com>
---
 nuitka/code_generation/AnnotateFunctionCodes.py | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/nuitka/code_generation/AnnotateFunctionCodes.py b/nuitka/code_generation/AnnotateFunctionCodes.py
index f1f880a03..4b7c81646 100644
--- a/nuitka/code_generation/AnnotateFunctionCodes.py
+++ b/nuitka/code_generation/AnnotateFunctionCodes.py
@@ -116,16 +116,31 @@ def _getCodeObjectCreationCode(context, marshalled, function_identifier):
     )
 
     if context.mayRecurse():
-        # Racing threads can at worst each unmarshal it, and keep one.
+        # Without the GIL, the cache is published with release ordering, so a
+        # thread that reads it never sees the pointer before the object, and
+        # a thread that loses the race to fill it releases its own copy and
+        # uses the winner's.
         code_object_setup = """\
     static PyObject *code_cache = NULL;
+#ifdef Py_GIL_DISABLED
+    PyObject *code = (PyObject *)_Py_atomic_load_ptr_acquire(&code_cache);
+#else
     PyObject *code = code_cache;
+#endif
     if (code == NULL) {
         code = PyMarshal_ReadObjectFromString(
             %(marshalled)s,
             %(marshalled_size)d);
         assert(code != NULL);
+#ifdef Py_GIL_DISABLED
+        PyObject *published = NULL;
+        if (!_Py_atomic_compare_exchange_ptr(&code_cache, &published, code)) {
+            Py_DECREF(code);
+            code = published;
+        }
+#else
         code_cache = code;
+#endif
     }
 """ % {
             "marshalled": marshalled_code,
