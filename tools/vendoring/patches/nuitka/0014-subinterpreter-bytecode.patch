+
+
+def getSubinterpreterBytecodeModules():
+    """*list*, items of ``--subinterpreter-bytecode=``"""
+    return tuple(
+        module_name.strip()
+        for value in options.subinterpreter_bytecode
+        for module_name in value.split(",")
+        if module_name.strip()
+    )
 
 
