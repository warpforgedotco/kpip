@@ -672,30 +762,43 @@ def _runCPgoBinary():
         "Running created binary to produce C level PGO information:", style="blue"
     )
 
-    if getSconsCompilerUsed(
-        OutputDirectories.getSourceDirectoryPath(onefile=False, create=False)
-    ) in ("MSVC", "ClangCL"):
