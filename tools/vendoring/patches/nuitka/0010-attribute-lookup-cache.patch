From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kevin Turcios <turcioskevinr@gmail.com>
Date: Thu, 24 Sep 2026 12:00:00 -0400
Subject: [PATCH] Python3.12+: Optimization: Cache attribute lookups per call
 site

Every attribute lookup searched the type and its bases again. Each
lookup site now remembers the type it last saw and that type's version
tag, which any change to the type or its bases resets. Like CPython's
"LOAD_ATTR_SLOT", a "__slots__" member is then read from its offset
directly, and a plain value of the type, e.g. a class constant, is used
as is. A plain value is only used for types without an instance dictionary,
where nothing can shadow it.

For 2000 runs over 1000 objects reading two slots and a class constant,
this takes 61 instead of 127 ms.

---
diff --git a/nuitka/build/include/nuitka/helper/attributes.h b/nuitka/build/include/nuitka/helper/attributes.h
index 60f06ab7e..e6bca4106 100644
--- a/nuitka/build/include/nuitka/helper/attributes.h
+++ b/nuitka/build/include/nuitka/helper/attributes.h
@@ -64,6 +64,39 @@ static inline bool hasTypeGenericGetAttr(PyTypeObject *type) {
 #endif
 }
 
+#if PYTHON_VERSION >= 0x3c0 && !defined(Py_GIL_DISABLED) && !_NUITKA_EXPERIMENTAL_DISABLE_ATTR_OPT
+#define _NUITKA_ATTRIBUTE_CACHE 1
+
+// Per call site memory of an attribute lookup, valid only while the type
+// keeps its version tag, which any change to the type or its bases resets.
+struct Nuitka_AttributeCache {
+    PyTypeObject *type;
+    unsigned int version;
+    // Offset of a "__slots__" member, or 0 when "value" is the result.
+    Py_ssize_t offset;
+    PyObject *value;
+};
+
+extern PyObject *LOOKUP_ATTRIBUTE_CACHE_FILL(PyThreadState *tstate, PyObject *source, PyObject *attr_name,
+                                             struct Nuitka_AttributeCache *cache);
+
+static inline PyObject *LOOKUP_ATTRIBUTE_CACHED(PyThreadState *tstate, PyObject *source, PyObject *attr_name,
+                                                struct Nuitka_AttributeCache *cache) {
+    PyTypeObject *type = Py_TYPE(source);
+
+    if (likely(cache->type == type && cache->version == type->tp_version_tag)) {
+        PyObject *result = cache->offset != 0 ? *(PyObject **)((char *)source + cache->offset) : cache->value;
+
+        if (likely(result != NULL)) {
+            Py_INCREF(result);
+            return result;
+        }
+    }
+
+    return LOOKUP_ATTRIBUTE_CACHE_FILL(tstate, source, attr_name, cache);
+}
+#endif
+
 // In case of DLL usage, this avoids looking up the symbol from it.
 extern setattrofunc PyObject_GenericSetAttr_resolved;
 
diff --git a/nuitka/build/static_src/HelpersAttributes.c b/nuitka/build/static_src/HelpersAttributes.c
index 6d4d5d6be..a7afa0905 100644
--- a/nuitka/build/static_src/HelpersAttributes.c
+++ b/nuitka/build/static_src/HelpersAttributes.c
@@ -250,6 +250,42 @@ PyObject *LOOKUP_ATTRIBUTE(PyThreadState *tstate, PyObject *source, PyObject *at
 #endif
 }
 
+#ifdef _NUITKA_ATTRIBUTE_CACHE
+PyObject *LOOKUP_ATTRIBUTE_CACHE_FILL(PyThreadState *tstate, PyObject *source, PyObject *attr_name,
+                                      struct Nuitka_AttributeCache *cache) {
+    PyTypeObject *type = Py_TYPE(source);
+
+    // Only results that need no call. A "__slots__" member is a data
+    // descriptor, which an instance dictionary cannot shadow, but a plain
+    // value of the type is only safe without one.
+    if (type->tp_getattro == PyObject_GenericGetAttr_resolved && type->tp_dict != NULL) {
+        PyObject *descr = Nuitka_TypeLookup(type, attr_name);
+        unsigned int version = type->tp_version_tag;
+
+        if (descr != NULL && version != 0) {
+            if (Py_TYPE(descr) == &PyMemberDescr_Type) {
+                PyMemberDef *member = ((PyMemberDescrObject *)descr)->d_member;
+
+                if (member->type == Py_T_OBJECT_EX && (member->flags & Py_AUDIT_READ) == 0 && member->offset > 0) {
+                    cache->type = type;
+                    cache->version = version;
+                    cache->offset = member->offset;
+                    cache->value = NULL;
+                }
+            } else if (Py_TYPE(descr)->tp_descr_get == NULL && hasTypeGenericGetAttr(type)) {
+                // The type dictionary holds it for as long as the version is valid.
+                cache->type = type;
+                cache->version = version;
+                cache->offset = 0;
+                cache->value = descr;
+            }
+        }
+    }
+
+    return LOOKUP_ATTRIBUTE(tstate, source, attr_name);
+}
+#endif
+
 PyObject *LOOKUP_ATTRIBUTE_DICT_SLOT(PyThreadState *tstate, PyObject *source) {
     CHECK_OBJECT(source);
 
diff --git a/nuitka/code_generation/AttributeCodes.py b/nuitka/code_generation/AttributeCodes.py
index 5dfb132e4..e8892aa52 100644
--- a/nuitka/code_generation/AttributeCodes.py
+++ b/nuitka/code_generation/AttributeCodes.py
@@ -6,6 +6,8 @@
 Attribute lookup, setting.
 """
 
+from nuitka.options.Options import isExperimental
+from nuitka.PythonVersions import python_version
 from nuitka.States import states
 
 from .CodeHelpers import (
@@ -98,6 +100,31 @@ def getAttributeLookupCode(
         emit("%s = LOOKUP_ATTRIBUTE_DICT_SLOT(tstate, %s);" % (to_name, source_name))
     elif attribute_name == "__class__":
         emit("%s = LOOKUP_ATTRIBUTE_CLASS_SLOT(tstate, %s);" % (to_name, source_name))
+    elif python_version >= 0x3C0 and not isExperimental("disable-attr-cache"):
+        cache_name = "%s_%s" % (
+            context.getEntryPoint().getCodeName(),
+            context.getUniqueCodeName("attribute_cache"),
+        )
+        context.addDeclaration(
+            cache_name,
+            "#ifdef _NUITKA_ATTRIBUTE_CACHE\n"
+            "static struct Nuitka_AttributeCache %s;\n"
+            "#endif" % cache_name,
+        )
+        emit(
+            """\
+#ifdef _NUITKA_ATTRIBUTE_CACHE
+%(to_name)s = LOOKUP_ATTRIBUTE_CACHED(tstate, %(source_name)s, %(attribute_name)s, &%(cache_name)s);
+#else
+%(to_name)s = LOOKUP_ATTRIBUTE(tstate, %(source_name)s, %(attribute_name)s);
+#endif"""
+            % {
+                "to_name": to_name,
+                "source_name": source_name,
+                "attribute_name": context.getConstantCode(attribute_name),
+                "cache_name": cache_name,
+            }
+        )
     else:
         emit(
             "%s = LOOKUP_ATTRIBUTE(tstate, %s, %s);"
