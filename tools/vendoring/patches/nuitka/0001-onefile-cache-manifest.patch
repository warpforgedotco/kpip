+#if _NUITKA_ONEFILE_TEMP_BOOL == 0 && _NUITKA_ONEFILE_HAS_PAYLOAD_BOOL == 1
+// In cached mode, a completed unpacking leaves a manifest file behind. It is
+// tied to the payload through a build time hash and records identity values
+// of every unpacked file. When all of them are unchanged, the next run can
+// skip decompression and checksum verification entirely, which otherwise costs
+// time proportional to the payload size on every start.
+#define ONEFILE_CACHE_MANIFEST_NAME FILENAME_EMPTY_STR ".nuitka-onefile-manifest"
+#define ONEFILE_CACHE_MANIFEST_MAGIC "NUITKAOM"
+#define ONEFILE_CACHE_MANIFEST_VERSION 1
+
+struct OnefileCacheFileIdentity {
+    uint64_t size;
+    uint64_t mtime;
+    uint64_t inode;
+};
+
+struct OnefileCacheManifestEntryHeader {
+    struct OnefileCacheFileIdentity identity;
+    uint32_t name_length;
+};
+
+static bool getOnefileCacheFileIdentity(filename_char_t const *filename, struct OnefileCacheFileIdentity *identity) {
+#if defined(_WIN32)
+    WIN32_FILE_ATTRIBUTE_DATA data;
+
+    if (GetFileAttributesExW(filename, GetFileExInfoStandard, &data) == 0) {
+        return false;
+    }
+
+    identity->size = ((uint64_t)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+    identity->mtime = ((uint64_t)data.ftLastWriteTime.dwHighDateTime << 32) | data.ftLastWriteTime.dwLowDateTime;
+    identity->inode = 0;
+#else
+    struct stat stat_buffer;
+
+    if (lstat(filename, &stat_buffer) != 0) {
+        return false;
+    }
+
+    identity->size = (uint64_t)stat_buffer.st_size;
+#if defined(__APPLE__) && __DARWIN_C_LEVEL >= __DARWIN_C_FULL
+    identity->mtime =
+        (uint64_t)stat_buffer.st_mtimespec.tv_sec * 1000000000ULL + (uint64_t)stat_buffer.st_mtimespec.tv_nsec;
+#elif defined(__APPLE__)
+    identity->mtime = (uint64_t)stat_buffer.st_mtime * 1000000000ULL + (uint64_t)stat_buffer.st_mtimensec;
+#elif defined(__linux__)
+    identity->mtime = (uint64_t)stat_buffer.st_mtim.tv_sec * 1000000000ULL + (uint64_t)stat_buffer.st_mtim.tv_nsec;
+#else
+    identity->mtime = (uint64_t)stat_buffer.st_mtime;
+#endif
+    identity->inode = (uint64_t)stat_buffer.st_ino;
+#endif
+
+    return true;
+}
+
+static char *cache_manifest_buffer = NULL;
+static size_t cache_manifest_size = 0;
+static size_t cache_manifest_allocated = 0;
+
+static void appendCacheManifestData(void const *data, size_t size) {
+    if (cache_manifest_size + size > cache_manifest_allocated) {
+        size_t new_allocated = cache_manifest_allocated == 0 ? 16384 : cache_manifest_allocated * 2;
+
+        while (cache_manifest_size + size > new_allocated) {
+            new_allocated *= 2;
+        }
+
+        char *new_buffer = (char *)realloc(cache_manifest_buffer, new_allocated);
+
+        if (new_buffer == NULL) {
+            fatalErrorMemory();
+        }
+
+        cache_manifest_buffer = new_buffer;
+        cache_manifest_allocated = new_allocated;
+    }
+
+    memcpy(cache_manifest_buffer + cache_manifest_size, data, size);
+    cache_manifest_size += size;
+}
+
+static void getCacheManifestFilename(filename_char_t *buffer, size_t buffer_size) {
+    buffer[0] = 0;
+
+    appendStringSafeFilename(buffer, payload_path, buffer_size);
+    appendCharSafeFilename(buffer, FILENAME_SEP_CHAR, buffer_size);
+    appendStringSafeFilename(buffer, ONEFILE_CACHE_MANIFEST_NAME, buffer_size);
+}
+
+static void startCacheManifest(void) {
+    static char const magic[] = ONEFILE_CACHE_MANIFEST_MAGIC;
+    static char const payload_hash[] = _NUITKA_ONEFILE_PAYLOAD_HASH;
+    uint32_t value;
+
+    appendCacheManifestData(magic, sizeof(magic) - 1);
+    value = ONEFILE_CACHE_MANIFEST_VERSION;
+    appendCacheManifestData(&value, sizeof(value));
+    value = (uint32_t)(sizeof(payload_hash) - 1);
+    appendCacheManifestData(&value, sizeof(value));
+    appendCacheManifestData(payload_hash, sizeof(payload_hash) - 1);
+}
+
+// Record an unpacked file, after it was completely written.
+static void addCacheManifestEntry(filename_char_t const *target_path) {
+    // Stored relative to the payload path, which may differ for the next run.
+    filename_char_t const *filename = target_path + strlenFilename(payload_path) + 1;
+
+    struct OnefileCacheManifestEntryHeader entry_header;
+    memset(&entry_header, 0, sizeof(entry_header));
+
+    // Not being able to record it only means, the next run will not use the
+    // manifest, as that is checked.
+    if (getOnefileCacheFileIdentity(target_path, &entry_header.identity) == false) {
+        entry_header.identity.size = (uint64_t)-1;
+    }
+
+    entry_header.name_length = (uint32_t)strlenFilename(filename);
+
+    appendCacheManifestData(&entry_header, sizeof(entry_header));
+    appendCacheManifestData(filename, entry_header.name_length * sizeof(filename_char_t));
+}
+
+// Commit the manifest, only called after all files were unpacked successfully.
+static void writeCacheManifest(void) {
+    static filename_char_t manifest_filename[4096];
+    static filename_char_t manifest_filename_tmp[4096];
+
+    getCacheManifestFilename(manifest_filename, sizeof(manifest_filename) / sizeof(filename_char_t));
+
+    // Use a process specific temporary name, so concurrent unpacking never
+    // exposes a partially written manifest.
+    copyStringSafeFilename(manifest_filename_tmp, manifest_filename,
+                           sizeof(manifest_filename_tmp) / sizeof(filename_char_t));
+    appendCharSafeFilename(manifest_filename_tmp, '.', sizeof(manifest_filename_tmp) / sizeof(filename_char_t));
+#if defined(_WIN32)
+    appendWStringSafeW(manifest_filename_tmp, L"tmp", sizeof(manifest_filename_tmp) / sizeof(filename_char_t));
+    {
+        wchar_t pid_buffer[32];
+        _snwprintf(pid_buffer, sizeof(pid_buffer) / sizeof(wchar_t), L"%lu", (unsigned long)GetCurrentProcessId());
+        pid_buffer[31] = 0;
+        appendWStringSafeW(manifest_filename_tmp, pid_buffer, sizeof(manifest_filename_tmp) / sizeof(filename_char_t));
+    }
+#else
+    {
+        char pid_buffer[32];
+        snprintf(pid_buffer, sizeof(pid_buffer), "tmp%ld", (long)getpid());
+        appendStringSafe(manifest_filename_tmp, pid_buffer, sizeof(manifest_filename_tmp));
+    }
+#endif
+
+    FILE_HANDLE manifest_file = createFileForWriting(manifest_filename_tmp);
+
+    if (manifest_file == FILE_HANDLE_NULL) {
+        return;
+    }
+
+    bool success = writeFileChunk(manifest_file, cache_manifest_buffer, cache_manifest_size);
+
+    if (closeFile(manifest_file) == false) {
+        success = false;
+    }
+
+    if (success) {
+#if defined(_WIN32)
+        success = MoveFileExW(manifest_filename_tmp, manifest_filename, MOVEFILE_REPLACE_EXISTING) != 0;
+#else
+        success = renameFile(manifest_filename_tmp, manifest_filename);
+#endif
+    }
+
+    if (success == false) {
+        deleteFile(manifest_filename_tmp);
+    }
+}
+
+static void invalidateCacheManifest(void) {
+    static filename_char_t manifest_filename[4096];
+
+    getCacheManifestFilename(manifest_filename, sizeof(manifest_filename) / sizeof(filename_char_t));
+    deleteFile(manifest_filename);
+}
+
+// Check if the manifest proves an unchanged complete unpacking of this very
+// payload. On success, the first file of the payload is provided, as that is
+// what the unpacking would have given.
+static bool checkCacheManifest(filename_char_t *first_filename, size_t first_filename_size) {
+    static filename_char_t manifest_filename[4096];
+
+    getCacheManifestFilename(manifest_filename, sizeof(manifest_filename) / sizeof(filename_char_t));
+
+    FILE_HANDLE manifest_file = openFileForReading(manifest_filename);
+
+    if (manifest_file == FILE_HANDLE_NULL) {
+        return false;
+    }
+
+    int64_t manifest_size = getFileSize(manifest_file);
+    char *manifest_data = NULL;
+    bool result = false;
+
+    if (manifest_size > 0 && manifest_size < 256 * 1024 * 1024) {
+        manifest_data = (char *)malloc((size_t)manifest_size);
+
+        if (manifest_data != NULL && readFileChunk(manifest_file, manifest_data, (size_t)manifest_size) == false) {
+            free(manifest_data);
+            manifest_data = NULL;
+        }
+    }
+
+    closeFile(manifest_file);
+
+    if (manifest_data == NULL) {
+        return false;
+    }
+
+    static char const magic[] = ONEFILE_CACHE_MANIFEST_MAGIC;
+    static char const payload_hash[] = _NUITKA_ONEFILE_PAYLOAD_HASH;
+
+    char const *current = manifest_data;
+    char const *end = manifest_data + manifest_size;
+    uint32_t value;
+
+    // Header is magic, version, hash length, hash value.
+    if ((size_t)(end - current) < sizeof(magic) - 1 + 2 * sizeof(uint32_t) + sizeof(payload_hash) - 1) {
+        goto finish;
+    }
+    if (memcmp(current, magic, sizeof(magic) - 1) != 0) {
+        goto finish;
+    }
+    current += sizeof(magic) - 1;
+
+    memcpy(&value, current, sizeof(value));
+    current += sizeof(value);
+    if (value != ONEFILE_CACHE_MANIFEST_VERSION) {
+        goto finish;
+    }
+
+    memcpy(&value, current, sizeof(value));
+    current += sizeof(value);
+    if (value != sizeof(payload_hash) - 1 || memcmp(current, payload_hash, value) != 0) {
+        goto finish;
+    }
+    current += value;
+
+    {
+        static filename_char_t target_path[4096];
+        static filename_char_t first_target_path[4096];
+        bool first = true;
+
+        while (current < end) {
+            struct OnefileCacheManifestEntryHeader entry_header;
+
+            if ((size_t)(end - current) < sizeof(entry_header)) {
+                goto finish;
+            }
+            memcpy(&entry_header, current, sizeof(entry_header));
+            current += sizeof(entry_header);
+
+            size_t name_size = entry_header.name_length * sizeof(filename_char_t);
+
+            if (entry_header.name_length == 0 || entry_header.name_length >= 1024 ||
+                (size_t)(end - current) < name_size) {
+                goto finish;
+            }
+
+            target_path[0] = 0;
+            appendStringSafeFilename(target_path, payload_path, sizeof(target_path) / sizeof(filename_char_t));
+            appendCharSafeFilename(target_path, FILENAME_SEP_CHAR, sizeof(target_path) / sizeof(filename_char_t));
+
+            size_t offset = strlenFilename(target_path);
+            if (offset + entry_header.name_length + 1 > sizeof(target_path) / sizeof(filename_char_t)) {
+                goto finish;
+            }
+            memcpy(target_path + offset, current, name_size);
+            target_path[offset + entry_header.name_length] = 0;
+            current += name_size;
+
+            struct OnefileCacheFileIdentity identity;
+
+            if (getOnefileCacheFileIdentity(target_path, &identity) == false ||
+                identity.size != entry_header.identity.size || identity.mtime != entry_header.identity.mtime ||
+                identity.inode != entry_header.identity.inode) {
+#ifdef _NUITKA_EXPERIMENTAL_DEBUG_ONEFILE_CACHING
+                fprintf(stderr, "CACHE MANIFEST MISMATCH for '" FILENAME_FORMAT_STR "'.\n", target_path);
+#endif
+                goto finish;
+            }
+
+            if (first) {
+                copyStringSafeFilename(first_target_path, target_path,
+                                       sizeof(first_target_path) / sizeof(filename_char_t));
+                first = false;
+            }
+        }
+
+        result = first == false;
+
+        // With the main binary not part of the payload, that is already known.
+        if (result && first_filename[0] == 0) {
+            copyStringSafeFilename(first_filename, first_target_path, first_filename_size);
+        }
+    }
+
+finish:
+    free(manifest_data);
+    return result;
+}
+#endif
