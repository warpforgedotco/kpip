 src/kpip/_internal/utils/distlib_resources.py | 23 +++++++++++++
 tests/unit/test_utils_distlib_resources.py    | 32 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 src/kpip/_internal/utils/distlib_resources.py
 create mode 100644 tests/unit/test_utils_distlib_resources.py

