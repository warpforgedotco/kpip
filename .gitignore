# macOS Finder metadata, in any directory.
.DS_Store

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.ruff_cache/
.mypy_cache/

.venv/
/build/
# The package's build module is source code, not the root build output.
!src/kpip/build/
dist/
*.egg-info/

# Recorded kpip-bench baselines (kpip-bench-record).
benchmark-runs/

# Compiled extensions, and the C Cython generates from pure-Python-mode
# sources (a blanket *.c would hide the test fixtures' real C sources).
*.so
*.pyd
src/kpip/_vendor/nab_resolver/_cranges.c
